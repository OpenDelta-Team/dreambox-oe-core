	path = meta-openembedded
	url = https://github.com/OpenDelta-Team/meta-openembedded
	branch = mickledore
	ignore = dirty
[submodule "openembedded-core"]
	path = openembedded-core
	url = https://github.com/OpenDelta-Team/openembedded-core
	branch = mickledore
	ignore = dirty
[submodule "meta-python2"]
	path = meta-python2
	url = https://github.com/OpenDelta-Team//meta-python2.git
	branch = master
	ignore = dirty
